{
    "version": "0.2.0",
    "configurations": [
    {
        "name": "Python: Current File from Project Root",
        "type": "debugpy",
        "request": "launch",
        "program": "${file}",
        "console": "integratedTerminal",
        "cwd": "${workspaceFolder}",
        "env": {
            "PYTHONPATH": "${workspaceFolder}"
        }
        }
    ]
}